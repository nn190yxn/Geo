generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("active")
  description String?
  aliases     Json     @default("[]")
  industry    String?
  website     String?
  targetCities Json    @default("[]") @map("target_cities")
  businessScope String? @map("business_scope")
  targetAudience String? @map("target_audience")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  platformConfigs PlatformConfig[]
  aiPlatformCallAudits AIPlatformCallAudit[]
  asyncJobs AsyncJob[]
  llmTaskRuns LLMTaskRun[]
  monitoringRuns  MonitoringRun[]
  geoMetricSnapshots GEOMetricSnapshot[]
  permissions     UserBrandPermission[]
  profile         BrandProfile?
  knowledgeSources KnowledgeSource[]
  optimizationUnits OptimizationUnit[]
  testThemes TestTheme[]
  testQuestionCandidates TestQuestionCandidate[]
  testPlans TestPlan[]
  browserConnectionSessions BrowserConnectionSession[]
  growthOptimizationPlans GrowthOptimizationPlan[]
  userIntents    UserIntent[]
  brandPrompts   BrandPrompt[]
  optimizationTasks OptimizationTask[]
  competitors Competitor[]
  competitorDiscoveryRuns CompetitorDiscoveryRun[]
  competitorCandidates CompetitorCandidate[]
  citationSources CitationSource[]
  contentAssets ContentAsset[]
  contentStrategies ContentStrategy[]
  evaluationIssues EvaluationIssue[]
  contentGenerationTasks ContentGenerationTask[]
  contentVersions ContentVersion[]
  contentExportRecords ContentExportRecord[]
  publishingAccounts PublishingAccount[]
  publishingRecords PublishingRecord[]
  automationPackages AutomationPackage[]
  automationConfirmations AutomationConfirmation[]
  visibilitySprints VisibilitySprint[]
  brandStandardAnswers BrandStandardAnswer[]
  platformRewriteVersions PlatformRewriteVersion[]
  testQuestionPoolItems TestQuestionPoolItem[]
  testQuestionSourceRecords TestQuestionSourceRecord[]
  reports Report[]
  advisorRecords AdvisorRecord[]
  innerTestFeedback InnerTestFeedback[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([industry])
  @@map("brands")
}

model Organization {
  id String @id @default(cuid())
  name String
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("organizations")
}

model Role {
  id String @id @default(cuid())
  code String
  name String
  scope String
  permissions Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]

  @@unique([code, scope])
  @@index([scope])
  @@map("roles")
}

model OrganizationMember {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  userId String @map("user_id")
  roleId String @map("role_id")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId], name: "unique_organization_user")
  @@index([userId])
  @@index([status])
  @@map("organization_members")
}

model OptimizationUnit {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  type String
  targetKeywords Json @default("[]") @map("target_keywords")
  priority String @default("medium")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  userIntents UserIntent[]
  brandPrompts BrandPrompt[]
  testThemes TestTheme[]
  contentStrategies ContentStrategy[]
  optimizationTasks OptimizationTask[]

  @@index([brandId])
  @@index([type])
  @@index([enabled])
  @@map("optimization_units")
}

model TestTheme {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String? @map("optimization_unit_id")
  type String
  name String
  businessExplanation String @default("") @map("business_explanation")
  priority String @default("medium")
  estimatedValue String @default("") @map("estimated_value")
  sourceProfileFields Json @default("[]") @map("source_profile_fields")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit? @relation(fields: [optimizationUnitId], references: [id], onDelete: SetNull)
  questionCandidates TestQuestionCandidate[]

  @@index([brandId])
  @@index([optimizationUnitId])
  @@index([type])
  @@index([enabled])
  @@map("test_themes")
}

model UserIntent {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String @map("optimization_unit_id")
  category String
  text String
  monitoringFrequency String @default("weekly") @map("monitoring_frequency")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit @relation(fields: [optimizationUnitId], references: [id], onDelete: Restrict)
  brandPrompts BrandPrompt[]
  contentStrategies ContentStrategy[]

  @@index([brandId])
  @@index([optimizationUnitId])
  @@index([category])
  @@map("user_intents")
}

model PromptTemplate {
  id String @id @default(cuid())
  name String
  industry String?
  category String
  text String
  targetKeywords Json @default("[]") @map("target_keywords")
  platformCodes Json @default("[]") @map("platform_codes")
  frequency String @default("weekly")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brandPrompts BrandPrompt[]

  @@index([category])
  @@index([industry])
  @@map("prompt_templates")
}

model BrandPrompt {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String @map("optimization_unit_id")
  intentId String @map("intent_id")
  templateId String? @map("template_id")
  text String
  category String
  targetKeywords Json @default("[]") @map("target_keywords")
  platformCodes Json @default("[]") @map("platform_codes")
  monitoringFrequency String @default("weekly") @map("monitoring_frequency")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit @relation(fields: [optimizationUnitId], references: [id], onDelete: Restrict)
  intent UserIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  template PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  monitoringRuns MonitoringRun[]
  questionCandidates TestQuestionCandidate[]
  optimizationTasks OptimizationTask[]

  @@index([brandId])
  @@index([intentId])
  @@index([enabled])
  @@map("brand_prompts")
}

model TestQuestionCandidate {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  themeId String @map("theme_id")
  promptId String? @map("prompt_id")
  question String
  purposes Json @default("[]")
  targetPlatforms Json @default("[]") @map("target_platforms")
  priority String @default("medium")
  estimatedValue String @default("") @map("estimated_value")
  editable Boolean @default(true)
  selected Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  theme TestTheme @relation(fields: [themeId], references: [id], onDelete: Restrict)
  prompt BrandPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  questionPoolItems TestQuestionPoolItem[]

  @@index([brandId])
  @@index([themeId])
  @@index([promptId])
  @@index([selected])
  @@map("test_question_candidates")
}

model KnowledgeSource {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  sourceType String @map("source_type")
  sourceUrl String? @map("source_url")
  fileRef String? @map("file_ref")
  status String @default("pending")
  errorMessage String? @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([status])
  @@map("knowledge_sources")
}

model BrandProfile {
  brandId String @id @map("brand_id")
  intro String @default("")
  valueProps Json @default("[]") @map("value_props")
  offerings Json @default("[]")
  proofPoints Json @default("[]") @map("proof_points")
  targetCustomers Json @default("[]") @map("target_customers")
  recommendedExpressions Json @default("[]") @map("recommended_expressions")
  blockedExpressions Json @default("[]") @map("blocked_expressions")
  contentRules Json @default("[]") @map("content_rules")
  competitors Json @default("[]")
  faqs Json @default("[]")
  completenessScore Int @default(0) @map("completeness_score")
  missingFields Json @default("[]") @map("missing_fields")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@map("brand_profiles")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?  @map("avatar_url")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions UserBrandPermission[]
  organizationMemberships OrganizationMember[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id String @id @default(cuid())
  brandId String? @map("brand_id")
  organizationId String? @map("organization_id")
  actorUserId String? @map("actor_user_id")
  action String
  resourceType String @map("resource_type")
  resourceId String? @map("resource_id")
  result String
  errorCode String? @map("error_code")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([result])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserBrandPermission {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  brandId   String   @map("brand_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([userId, brandId], name: "unique_user_brand_role")
  @@index([brandId])
  @@map("user_brand_permissions")
}

model DeniedAccessLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  brandId     String   @map("brand_id")
  reason      String
  requestedAt DateTime @default(now()) @map("requested_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([brandId])
  @@index([requestedAt])
  @@map("denied_access_logs")
}

model PlatformConfig {
  id            String   @id @default(cuid())
  brandId       String   @map("brand_id")
  platformKey   String   @map("platform_key")
  displayName   String   @map("display_name")
  mode          String   @default("manual")
  endpointUrl   String?  @map("endpoint_url")
  modelName     String?  @map("model_name")
  rateLimitPerMinute Int @default(60) @map("rate_limit_per_minute")
  enabled       Boolean  @default(true)
  credentialRef String?  @map("credential_ref")
  lastValidation Json?   @map("last_validation")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, platformKey])
  @@index([brandId, enabled])
  @@map("platform_configs")
}

model BrowserConnectionSession {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  platformCode String @map("platform_code")
  status String @default("not_started")
  loginDetected Boolean @default(false) @map("login_detected")
  authorizedScope Json @default("{}") @map("authorized_scope")
  lastOperation String? @map("last_operation")
  lastIssueType String? @map("last_issue_type")
  lastMessage String? @map("last_message")
  lastAvailableAt DateTime? @map("last_available_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([platformCode])
  @@index([status])
  @@index([lastAvailableAt])
  @@map("browser_connection_sessions")
}

model AIPlatformCallAudit {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  platformCode String @map("platform_code")
  modelName String? @map("model_name")
  callType String @map("call_type")
  status String @default("started")
  durationMs Int? @map("duration_ms")
  inputTokenCount Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  costEstimate Decimal? @map("cost_estimate") @db.Decimal(12, 6)
  errorCode String? @map("error_code")
  errorMessage String? @map("error_message")
  retryable Boolean?
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([platformCode])
  @@index([callType])
  @@index([status])
  @@index([startedAt])
  @@map("ai_platform_call_audits")
}

model AsyncJob {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  jobType String @map("job_type")
  status String @default("queued")
  entityId String @map("entity_id")
  attemptCount Int @default(0) @map("attempt_count")
  maxAttempts Int @default(3) @map("max_attempts")
  nextRunAt DateTime? @map("next_run_at")
  lastErrorCode String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([jobType])
  @@index([status])
  @@index([entityId])
  @@index([nextRunAt])
  @@map("async_jobs")
}

model LLMTaskRun {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  taskType String @map("task_type")
  status String @default("queued")
  jobId String? @map("job_id")
  auditId String? @map("audit_id")
  inputSummary Json @default("{}") @map("input_summary")
  outputSummary Json? @map("output_summary")
  errorCode String? @map("error_code")
  errorMessage String? @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([taskType])
  @@index([status])
  @@index([jobId])
  @@index([auditId])
  @@map("llm_task_runs")
}

model MonitoringRun {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String @map("optimization_unit_id")
  intentId String @map("intent_id")
  promptId String @map("prompt_id")
  testPlanId String? @map("test_plan_id")
  platformCode String @map("platform_code")
  status String @default("pending")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  errorMessage String? @map("error_message")
  retryStatus String @default("not_retried") @map("retry_status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  prompt BrandPrompt @relation(fields: [promptId], references: [id], onDelete: Restrict)
  testPlan TestPlan? @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  responses AIResponse[]

  @@index([brandId])
  @@index([promptId, platformCode])
  @@index([testPlanId])
  @@index([status])
  @@index([createdAt])
  @@map("monitoring_runs")
}

model TestPlan {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  status String @default("draft")
  questions Json @default("[]")
  platformCodes Json @default("[]") @map("platform_codes")
  connectionSummary Json @default("[]") @map("connection_summary")
  executionMethod String @default("manual") @map("execution_method")
  estimatedDurationMinutes Int @default(0) @map("estimated_duration_minutes")
  confirmationItems Json @default("[]") @map("confirmation_items")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  monitoringRuns MonitoringRun[]
  growthOptimizationPlans GrowthOptimizationPlan[]

  @@index([brandId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("test_plans")
}

model AIResponse {
  id String @id @default(cuid())
  runId String @map("run_id")
  brandId String @map("brand_id")
  rawText String @map("raw_text")
  citations Json @default("[]")
  modelName String? @map("model_name")
  respondedAt DateTime @map("responded_at")
  parseStatus String @default("pending") @map("parse_status")
  createdAt DateTime @default(now()) @map("created_at")

  run MonitoringRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  analysisResult AnalysisResult?
  citationSources CitationSource[]
  evaluationIssues EvaluationIssue[]

  @@index([runId])
  @@index([brandId])
  @@map("ai_responses")
}

model AnalysisResult {
  id String @id @default(cuid())
  responseId String @unique @map("response_id")
  runId String @map("run_id")
  brandId String @map("brand_id")
  brandMentioned Boolean @default(false) @map("brand_mentioned")
  brandRank Int? @map("brand_rank")
  sentiment String @default("unknown")
  accuracyScore Int @default(0) @map("accuracy_score")
  citationScore Int @default(0) @map("citation_score")
  platformEvaluation String @default("") @map("platform_evaluation")
  recommendationReason String @default("") @map("recommendation_reason")
  rankingReason String @default("") @map("ranking_reason")
  expressionCompleteness String @default("") @map("expression_completeness")
  expressionDeviation String @default("") @map("expression_deviation")
  competitorMentions Json @default("[]") @map("competitor_mentions")
  reviewRequired Boolean @default(true) @map("review_required")
  updatedAt DateTime @updatedAt @map("updated_at")

  response AIResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([runId])
  @@index([reviewRequired])
  @@map("analysis_results")
}

model GEOMetricSnapshot {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  period String
  platformCode String? @map("platform_code")
  optimizationUnitId String? @map("optimization_unit_id")
  intentId String? @map("intent_id")
  category String?
  mentionScore Int @default(0) @map("mention_score")
  rankingScore Int @default(0) @map("ranking_score")
  accuracyScore Int @default(0) @map("accuracy_score")
  sentimentScore Int @default(0) @map("sentiment_score")
  citationScore Int @default(0) @map("citation_score")
  competitorScore Int @default(0) @map("competitor_score")
  knowledgeCompletenessScore Int @default(0) @map("knowledge_completeness_score")
  totalScore Int @default(0) @map("total_score")
  sampleCount Int @default(0) @map("sample_count")
  insufficientSample Boolean @default(true) @map("insufficient_sample")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, period])
  @@index([platformCode])
  @@index([optimizationUnitId])
  @@index([intentId])
  @@map("geo_metric_snapshots")
}

model Competitor {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  aliases Json @default("[]")
  website String?
  industryTags Json @default("[]") @map("industry_tags")
  comparisonNote String @default("") @map("comparison_note")
  suppressionRule Json @default("{}") @map("suppression_rule")
  confirmationLabel String? @map("confirmation_label")
  sourceCandidateId String? @map("source_candidate_id")
  sourceProvider String? @map("source_provider")
  nearestCampusDistanceKm Float? @map("nearest_campus_distance_km")
  isNationalBenchmark Boolean @default(false) @map("is_national_benchmark")
  isCampusFocus Boolean @default(false) @map("is_campus_focus")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([name])
  @@index([confirmationLabel])
  @@index([sourceCandidateId])
  @@map("competitors")
}

model CompetitorDiscoveryRun {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  city String
  campusRadiusKm Int @map("campus_radius_km")
  keywords Json @default("[]")
  status String
  candidateCount Int @default(0) @map("candidate_count")
  missingFields Json @default("[]") @map("missing_fields")
  sourceProvider String @map("source_provider")
  providerStatus String @default("fallback") @map("provider_status")
  providerMessage String @default("") @map("provider_message")
  cacheHit Boolean @default(false) @map("cache_hit")
  createdBy String @map("created_by")
  failureReason String? @map("failure_reason")
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  candidates CompetitorCandidate[]

  @@index([brandId])
  @@index([status])
  @@index([sourceProvider])
  @@index([providerStatus])
  @@index([createdAt])
  @@map("competitor_discovery_runs")
}

model CompetitorCandidate {
  id String @id @default(cuid())
  runId String @map("run_id")
  brandId String @map("brand_id")
  sourceProvider String @map("source_provider")
  sourcePoiId String? @map("source_poi_id")
  name String
  address String?
  city String?
  latitude Float?
  longitude Float?
  category String?
  distanceToNearestCampusKm Float? @map("distance_to_nearest_campus_km")
  matchedKeywords Json @default("[]") @map("matched_keywords")
  score Int
  suggestedLabel String @map("suggested_label")
  confirmedLabel String? @map("confirmed_label")
  matchReasons Json @default("[]") @map("match_reasons")
  confidence String
  isCampusFocus Boolean @default(false) @map("is_campus_focus")
  decisionStatus String @default("pending") @map("decision_status")
  excludedReason String? @map("excluded_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  run CompetitorDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([runId])
  @@index([sourceProvider, sourcePoiId])
