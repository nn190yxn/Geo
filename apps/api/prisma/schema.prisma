generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id          String   @id @default(cuid())
  organizationId String @map("organization_id")
  name        String
  status      String   @default("active")
  description String?
  aliases     Json     @default("[]")
  industry    String?
  website     String?
  targetCities Json    @default("[]") @map("target_cities")
  businessScope String? @map("business_scope")
  targetAudience String? @map("target_audience")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  platformConfigs PlatformConfig[]
  aiPlatformCallAudits AIPlatformCallAudit[]
  asyncJobs AsyncJob[]
  llmTaskRuns LLMTaskRun[]
  monitoringRuns  MonitoringRun[]
  geoMetricSnapshots GEOMetricSnapshot[]
  measurementAttributions MeasurementAttribution[]
  permissions     UserBrandPermission[]
  profile         BrandProfile?
  knowledgeSources KnowledgeSource[]
  knowledgeChunks KnowledgeChunk[]
  brandMediaAssets BrandMediaAsset[]
  optimizationUnits OptimizationUnit[]
  testThemes TestTheme[]
  testQuestionCandidates TestQuestionCandidate[]
  testPlans TestPlan[]
  browserConnectionSessions BrowserConnectionSession[]
  growthOptimizationPlans GrowthOptimizationPlan[]
  userIntents    UserIntent[]
  brandPrompts   BrandPrompt[]
  optimizationTasks OptimizationTask[]
  competitors Competitor[]
  competitorDiscoveryRuns CompetitorDiscoveryRun[]
  competitorCandidates CompetitorCandidate[]
  citationSources CitationSource[]
  contentAssets ContentAsset[]
  contentStrategies ContentStrategy[]
  evaluationIssues EvaluationIssue[]
  contentGenerationTasks ContentGenerationTask[]
  contentVersions ContentVersion[]
  contentExportRecords ContentExportRecord[]
  publishingAccounts PublishingAccount[]
  publishingRecords PublishingRecord[]
  mediaPlatformRules MediaPlatformRule[]
  analysisFindings AnalysisFinding[]
  automationPackages AutomationPackage[]
  automationConfirmations AutomationConfirmation[]
  visibilitySprints VisibilitySprint[]
  brandStandardAnswers BrandStandardAnswer[]
  platformRewriteVersions PlatformRewriteVersion[]
  testQuestionPoolItems TestQuestionPoolItem[]
  testQuestionSourceRecords TestQuestionSourceRecord[]
  searchDemandSnapshots SearchDemandSnapshot[]
  searchDemandCandidates SearchDemandCandidate[]
  reports Report[]
  operationCycles OperationCycle[]
  deliveryBundles DeliveryBundle[]
  clientReadGrants ClientReadGrant[]
  publicBrandProfile PublicBrandProfile?
  advisorRecords AdvisorRecord[]
  innerTestFeedback InnerTestFeedback[]
  auditLogs AuditLog[]
  quickStartSession QuickStartSession?
  diagnosticScoreSnapshots DiagnosticScoreSnapshot[]
  taskAcceptanceSnapshots TaskAcceptanceSnapshot[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productEvents ProductEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([industry])
  @@map("brands")
}

model QuickStartSession {
  id String @id @default(cuid())
  brandId String @unique @map("brand_id")
  currentStep String @default("website") @map("current_step")
  status String @default("in_progress")
  draft Json @default("{}")
  version Int @default(1)
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("quick_start_sessions")
}

model DiagnosticScoreSnapshot {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  websiteUrl String @map("website_url")
  rawChecks Json @map("raw_checks")
  dimensionScores Json @map("dimension_scores")
  normalizedWeights Json @map("normalized_weights")
  policy Json
  ruleVersion String @map("rule_version")
  totalScore Float @map("total_score")
  createdAt DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, createdAt])
  @@index([ruleVersion])
  @@map("diagnostic_score_snapshots")
}

model Organization {
  id String @id @default(cuid())
  name String
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]
  auditLogs AuditLog[]
  brands Brand[]
  productEvents ProductEvent[]

  @@index([status])
  @@map("organizations")
}

model ProductEvent {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  brandId String @map("brand_id")
  actorUserId String? @map("actor_user_id")
  eventType String @map("event_type")
  entityType String? @map("entity_type")
  entityId String? @map("entity_id")
  failureCategory String? @map("failure_category")
  metadata Json @default("{}")
  idempotencyKey String @map("idempotency_key")
  occurredAt DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, eventType, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([brandId, occurredAt])
  @@index([brandId, eventType, occurredAt])
  @@map("product_events")
}

model Role {
  id String @id @default(cuid())
  code String
  name String
  scope String
  permissions Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]

  @@unique([code, scope])
  @@index([scope])
  @@map("roles")
}

model OrganizationMember {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  userId String @map("user_id")
  roleId String @map("role_id")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId], name: "unique_organization_user")
  @@index([userId])
  @@index([status])
  @@map("organization_members")
}

model OptimizationUnit {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  type String
  targetKeywords Json @default("[]") @map("target_keywords")
  priority String @default("medium")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  userIntents UserIntent[]
  brandPrompts BrandPrompt[]
  testThemes TestTheme[]
  contentStrategies ContentStrategy[]
  optimizationTasks OptimizationTask[]
  analysisFindings AnalysisFinding[]

  @@index([brandId])
  @@index([type])
  @@index([enabled])
  @@map("optimization_units")
}

model TestTheme {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String? @map("optimization_unit_id")
  type String
  name String
  businessExplanation String @default("") @map("business_explanation")
  priority String @default("medium")
  estimatedValue String @default("") @map("estimated_value")
  sourceProfileFields Json @default("[]") @map("source_profile_fields")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit? @relation(fields: [optimizationUnitId], references: [id], onDelete: SetNull)
  questionCandidates TestQuestionCandidate[]

  @@index([brandId])
  @@index([optimizationUnitId])
  @@index([type])
  @@index([enabled])
  @@map("test_themes")
}

model UserIntent {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String @map("optimization_unit_id")
  category String
  text String
  monitoringFrequency String @default("weekly") @map("monitoring_frequency")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit @relation(fields: [optimizationUnitId], references: [id], onDelete: Restrict)
  brandPrompts BrandPrompt[]
  contentStrategies ContentStrategy[]

  @@index([brandId])
  @@index([optimizationUnitId])
  @@index([category])
  @@map("user_intents")
}

model PromptTemplate {
  id String @id @default(cuid())
  name String
  industry String?
  category String
  text String
  targetKeywords Json @default("[]") @map("target_keywords")
  platformCodes Json @default("[]") @map("platform_codes")
  frequency String @default("weekly")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brandPrompts BrandPrompt[]

  @@index([category])
  @@index([industry])
  @@map("prompt_templates")
}

model BrandPrompt {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  optimizationUnitId String @map("optimization_unit_id")
  intentId String @map("intent_id")
  templateId String? @map("template_id")
  text String
  promptKind String @default("discovery") @map("prompt_kind")
  category String
  targetKeywords Json @default("[]") @map("target_keywords")
  platformCodes Json @default("[]") @map("platform_codes")
  monitoringFrequency String @default("weekly") @map("monitoring_frequency")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  optimizationUnit OptimizationUnit @relation(fields: [optimizationUnitId], references: [id], onDelete: Restrict)
  intent UserIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  template PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  monitoringRuns MonitoringRun[]
  questionCandidates TestQuestionCandidate[]
  optimizationTasks OptimizationTask[]

  @@index([brandId])
  @@index([intentId])
  @@index([enabled])
  @@index([promptKind])
  @@map("brand_prompts")
}

model TestQuestionCandidate {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  themeId String @map("theme_id")
  promptId String? @map("prompt_id")
  question String
  promptKind String @default("discovery") @map("prompt_kind")
  purposes Json @default("[]")
  targetPlatforms Json @default("[]") @map("target_platforms")
  priority String @default("medium")
  estimatedValue String @default("") @map("estimated_value")
  discoveryDimension String? @map("discovery_dimension")
  businessValue String? @map("business_value")
  recommendationProbability Float? @map("recommendation_probability")
  userStage String? @map("user_stage")
  generationRationale String? @map("generation_rationale")
  generationMethod String? @map("generation_method")
  mergedFrom Json @default("[]") @map("merged_from")
  editable Boolean @default(true)
  selected Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  theme TestTheme @relation(fields: [themeId], references: [id], onDelete: Restrict)
  prompt BrandPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  questionPoolItems TestQuestionPoolItem[]

  @@index([brandId])
  @@index([themeId])
  @@index([discoveryDimension])
  @@index([promptId])
  @@index([selected])
  @@index([promptKind])
  @@map("test_question_candidates")
}

model KnowledgeSource {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  name String
  sourceType String @map("source_type")
  sourceUrl String? @map("source_url")
  fileRef String? @map("file_ref")
  status String @default("pending")
  errorMessage String? @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  chunks KnowledgeChunk[]

  @@index([brandId])
  @@index([status])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  sourceId String @map("source_id")
  sourceUrl String? @map("source_url")
  sourceVersion Int @map("source_version")
  chunkIndex Int @map("chunk_index")
  content String
  contentHash String @map("content_hash")
  reviewStatus String @default("pending") @map("review_status")
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([brandId, sourceId, sourceVersion, chunkIndex])
  @@index([brandId, reviewStatus])
  @@index([sourceId, sourceVersion])
  @@map("knowledge_chunks")
}

model BrandProfile {
  brandId String @id @map("brand_id")
  intro String @default("")
  valueProps Json @default("[]") @map("value_props")
  offerings Json @default("[]")
  proofPoints Json @default("[]") @map("proof_points")
  targetCustomers Json @default("[]") @map("target_customers")
  recommendedExpressions Json @default("[]") @map("recommended_expressions")
  blockedExpressions Json @default("[]") @map("blocked_expressions")
  contentRules Json @default("[]") @map("content_rules")
  competitors Json @default("[]")
  faqs Json @default("[]")
  completenessScore Int @default(0) @map("completeness_score")
  missingFields Json @default("[]") @map("missing_fields")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@map("brand_profiles")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?  @map("avatar_url")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions UserBrandPermission[]
  organizationMemberships OrganizationMember[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id String @id @default(cuid())
  brandId String? @map("brand_id")
  organizationId String? @map("organization_id")
  actorUserId String? @map("actor_user_id")
  action String
  resourceType String @map("resource_type")
  resourceId String? @map("resource_id")
  result String
  errorCode String? @map("error_code")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([result])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserBrandPermission {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  brandId   String   @map("brand_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([userId, brandId], name: "unique_user_brand_role")
  @@index([brandId])
  @@map("user_brand_permissions")
}

model DeniedAccessLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  brandId     String   @map("brand_id")
  reason      String
  requestedAt DateTime @default(now()) @map("requested_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([brandId])
  @@index([requestedAt])
  @@map("denied_access_logs")
}

model PlatformConfig {
  id            String   @id @default(cuid())
  brandId       String   @map("brand_id")
  platformKey   String   @map("platform_key")
  displayName   String   @map("display_name")
  mode          String   @default("manual")
  endpointUrl   String?  @map("endpoint_url")
  modelName     String?  @map("model_name")
  rateLimitPerMinute Int @default(60) @map("rate_limit_per_minute")
  enabled       Boolean  @default(true)
  credentialRef String?  @map("credential_ref")
  lastValidation Json?   @map("last_validation")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, platformKey])
  @@index([brandId, enabled])
  @@map("platform_configs")
}

model OrganizationProviderConfig {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  platformCode String @map("platform_code")
  modelName String @map("model_name")
  endpointUrl String? @map("endpoint_url")
  purpose String @default("generation")
  credentialRef String? @map("credential_ref")
  enabled Boolean @default(true)
  priority Int @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, platformCode, purpose])
  @@index([organizationId, enabled, priority])
  @@map("organization_provider_configs")
}

model ProviderHealthCheck {
  id String @id @default(cuid())
  providerConfigId String @map("provider_config_id")
  status String
  latencyMs Int? @map("latency_ms")
  errorCategory String? @map("error_category")
  checkedAt DateTime @default(now()) @map("checked_at")
  expiresAt DateTime @map("expires_at")

  @@index([providerConfigId, checkedAt])
  @@map("provider_health_checks")
}

model BrowserConnectionSession {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  platformCode String @map("platform_code")
  status String @default("not_started")
  loginDetected Boolean @default(false) @map("login_detected")
  authorizedScope Json @default("{}") @map("authorized_scope")
  lastOperation String? @map("last_operation")
  lastIssueType String? @map("last_issue_type")
  lastMessage String? @map("last_message")
  lastAvailableAt DateTime? @map("last_available_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([platformCode])
  @@index([status])
  @@index([lastAvailableAt])
  @@map("browser_connection_sessions")
}

model AIPlatformCallAudit {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  platformCode String @map("platform_code")
  modelName String? @map("model_name")
  callType String @map("call_type")
  status String @default("started")
  durationMs Int? @map("duration_ms")
  inputTokenCount Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  costEstimate Decimal? @map("cost_estimate") @db.Decimal(12, 6)
  errorCode String? @map("error_code")
  errorMessage String? @map("error_message")
  retryable Boolean?
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([platformCode])
  @@index([callType])
  @@index([status])
  @@index([startedAt])
  @@map("ai_platform_call_audits")
}

model AsyncJob {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  jobType String @map("job_type")
  status String @default("queued")
  entityId String @map("entity_id")
  idempotencyKey String? @map("idempotency_key")
  stepCode String? @map("step_code")
  progress Json @default("{}")
  resultSummary Json? @map("result_summary")
  attemptCount Int @default(0) @map("attempt_count")
  maxAttempts Int @default(3) @map("max_attempts")
  nextRunAt DateTime? @map("next_run_at")
  lastErrorCode String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([jobType])
  @@index([status])
  @@index([entityId])
  @@index([nextRunAt])
  @@unique([brandId, idempotencyKey])
  @@map("async_jobs")
}

model LLMTaskRun {
  id String @id @default(cuid())
  brandId String @map("brand_id")
  taskType String @map("task_type")
  status String @default("queued")
  jobId String? @map("job_id")
  auditId String? @map("audit_id")
  inputSummary Json @default("{}") @map("input_summary")
  outputSummary Json? @map("output_summary")
  errorCode String? @map("error_code")
  errorMessage String? @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId])
  @@index([taskType])
  @@index([status])
  @@index([jobId])
  @@index([auditId])
  @@map("llm_task_runs")
}

model QuotaAccount {
  id String @id @default(cuid())
  scopeType String @map("scope_type")
  scopeId String @map("scope_id")
  limitAmount Decimal? @map("limit_amount") @db.Decimal(12, 6)
  reservedAmount Decimal @default(0) @map("reserved_amount") @db.Decimal(12, 6)
  consumedAmount Decimal @default(0) @map("consumed_amount") @db.Decimal(12, 6)
  enabled Boolean @default(true)
  frozen Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId])
  @@index([scopeType])
  @@map("quota_accounts")
}

model QuotaAdjustmentAudit {
  id String @id @default(cuid())
  actorId String @map("actor_id")
  scopeType String @map("scope_type")
  scopeId String @map("scope_id")
  reason String
  beforeAmount Decimal @map("before_amount") @db.Decimal(12, 6)
  afterAmount Decimal @map("after_amount") @db.Decimal(12, 6)
  deltaAmount Decimal @map("delta_amount") @db.Decimal(12, 6)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([scopeType, scopeId, createdAt])
  @@index([actorId, createdAt])
  @@map("quota_adjustment_audits")
}

model UsageReservation {
  id String @id @default(cuid())
  taskKey String @unique @map("task_key")
  userId String @map("user_id")
  organizationId String @map("organization_id")
  brandId String @map("brand_id")
  taskType String @map("task_type")
  requestedCost Decimal @map("requested_cost") @db.Decimal(12, 6)
  settledCost Decimal @default(0) @map("settled_cost") @db.Decimal(12, 6)
  status String @default("reserved")
  rejectionReason String? @map("rejection_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([brandId])
  @@index([status])
  @@map("usage_reservations")
}

model UsageLedgerEntry {
  id String @id @default(cuid())
  reservationId String @map("reservation_id")
  eventType String @map("event_type")
  amount Decimal @default(0) @db.Decimal(12, 6)
  providerCode String? @map("provider_code")
  attemptOrder Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reservationId])
  @@index([eventType])
  @@map("usage_ledger_entries")
}

model ProviderSpendStage {
  id String @id @default(cuid())
  taskKey String @map("task_key")
  stepCode String @map("step_code")
  attemptOrder Int @map("attempt_order")
  leaseToken String? @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  providerCode String? @map("provider_code")
  incurredCost Decimal @default(0) @map("incurred_cost") @db.Decimal(12, 6)
  completedAt DateTime? @map("completed_at")
