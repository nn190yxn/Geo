{
  "name": "geo-platform",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; npm run dev --workspace @geo-platform/api & npm run dev --workspace @geo-platform/web",
    "dev:web": "npm run dev --workspace @geo-platform/web",
    "dev:api": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; npm run dev --workspace @geo-platform/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "package:check": "node deploy/validate-config.mjs deploy/compose.env.example",
    "verify": "npm audit && npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run test && npm run build",
    "prisma:validate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://geo:geo@localhost:5432/geo_platform?schema=public}\" npx prisma validate --schema apps/api/prisma/schema.prisma",
    "prisma:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://geo:geo@localhost:5432/geo_platform?schema=public}\" npm run prisma:generate --workspace @geo-platform/api",
    "prisma:migrate:deploy": "DATABASE_URL=\"${DATABASE_URL:-postgresql://geo:geo@localhost:5432/geo_platform?schema=public}\" npm run prisma:migrate:deploy --workspace @geo-platform/api",
    "prisma:seed": "DATABASE_URL=\"${DATABASE_URL:-postgresql://geo:geo@localhost:5432/geo_platform?schema=public}\" npm run prisma:seed --workspace @geo-platform/api",
    "db:prepare": "npm run prisma:generate && npm run prisma:seed",
    "desktop:test": "node --test desktop/*.test.cjs"
  },
  "devDependencies": {
    "electron": "37.2.6"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.5",
    "multer": "2.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-musl": "1.1.4",
    "@rolldown/binding-win32-x64-msvc": "1.1.4",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
